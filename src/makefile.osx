# Mac OS X makefile for Nu (nud)
# Updated for modern macOS (Apple Silicon arm64 & Intel x86_64)

CXX ?= clang++

# Homebrew prefixes
BREW_PREFIX ?= $(shell brew --prefix 2>/dev/null || echo /opt/homebrew)
BOOST_PREFIX ?= $(shell brew --prefix boost@1.85 2>/dev/null || brew --prefix boost 2>/dev/null || echo $(BREW_PREFIX))
BDB_PREFIX ?= $(shell brew --prefix berkeley-db@5 2>/dev/null || brew --prefix berkeley-db@4 2>/dev/null || brew --prefix berkeley-db 2>/dev/null || echo $(BREW_PREFIX))
OPENSSL_PREFIX ?= $(shell brew --prefix openssl@3 2>/dev/null || brew --prefix openssl 2>/dev/null || echo $(BREW_PREFIX)/opt/openssl@3)

INCLUDEPATHS = \
 -I"$(CURDIR)" \
 -I"$(CURDIR)/obj" \
 -I"$(OPENSSL_PREFIX)/include" \
 -I"$(BOOST_PREFIX)/include" \
 -I"$(BDB_PREFIX)/include" \
 -I"$(BREW_PREFIX)/include"

LIBPATHS = \
 -L"$(OPENSSL_PREFIX)/lib" \
 -L"$(BOOST_PREFIX)/lib" \
 -L"$(BDB_PREFIX)/lib" \
 -L"$(BREW_PREFIX)/lib"

LIBS = -dead_strip \
 -ldb_cxx \
 -lboost_system-mt \
 -lboost_filesystem-mt \
 -lboost_program_options-mt \
 -lboost_thread-mt \
 -lboost_chrono-mt \
 -lcurl \
 -lssl \
 -lcrypto \
 -lz

TESTDEFS = -DTEST_DATA_DIR=$(abspath test/data)
TESTLIBS = -lboost_unit_test_framework-mt
TESTDEFS += -DBOOST_TEST_DYN_LINK

DEFS = -DMAC_OSX -DMSG_NOSIGNAL=0 -DBOOST_SPIRIT_THREADSAFE -DBOOST_BIND_GLOBAL_PLACEHOLDERS

USE_UPNP ?= 0
ifneq ($(USE_UPNP),0)
ifneq ($(USE_UPNP),-)
	DEFS += -DUSE_UPNP=$(USE_UPNP)
	LIBS += -lminiupnpc
endif
endif

ifdef RELEASE
CFLAGS = -O3
else
CFLAGS = -O2 -g
endif

ifdef ARCH
CFLAGS += -arch $(ARCH)
endif

CFLAGS += -std=c++17 \
 -Wextra -Wno-sign-compare -Wno-invalid-offsetof -Wno-unused-parameter -Wformat-security \
 -Wno-reserved-user-defined-literal -Wno-deprecated-declarations \
 $(DEBUGFLAGS) $(DEFS) $(INCLUDEPATHS)

OBJS = \
    obj/scanbalance.o \
    obj/version.o \
    obj/checkpoints.o \
    obj/netbase.o \
    obj/addrman.o \
    obj/crypter.o \
    obj/key.o \
    obj/db.o \
    obj/init.o \
    obj/irc.o \
    obj/keystore.o \
    obj/main.o \
    obj/net.o \
    obj/protocol.o \
    obj/bitcoinrpc.o \
    obj/rpcdump.o \
    obj/script.o \
    obj/util.o \
    obj/wallet.o \
    obj/walletdb.o \
    obj/noui.o \
    obj/kernel.o \
    obj/distribution.o \
    obj/vote.o \
    obj/liquidityinfo.o \
    obj/datafeed.o

all: nud

# Ensure dependency directories exist
obj:
	@mkdir -p obj

obj-test:
	@mkdir -p obj-test

# Auto-generated dependencies:
-include obj/*.P
-include obj-test/*.P

obj/build.h: FORCE | obj
	@/bin/sh ../share/genbuild.sh obj/build.h

version.cpp: obj/build.h
DEFS += -DHAVE_BUILD_INFO

obj/%.o: %.cpp | obj
	$(CXX) -c $(CFLAGS) -MMD -o $@ $<
	@cp $(@:%.o=%.d) $(@:%.o=%.P); \
	  sed -e 's/#.*//' -e 's/^[^:]*: *//' -e 's/ *\\$$//' \
	      -e '/^$$/ d' -e 's/$$/ :/' < $(@:%.o=%.d) >> $(@:%.o=%.P); \
	  rm -f $(@:%.o=%.d)

nud: $(OBJS)
	$(CXX) $(CFLAGS) -o $@ $(LIBPATHS) $^ $(LIBS)

TESTOBJS := $(patsubst test/%.cpp,obj-test/%.o,$(wildcard test/*.cpp))

obj-test/%.o: test/%.cpp | obj-test
	$(CXX) -c $(TESTDEFS) $(CFLAGS) -MMD -o $@ $<
	@cp $(@:%.o=%.d) $(@:%.o=%.P); \
	  sed -e 's/#.*//' -e 's/^[^:]*: *//' -e 's/ *\\$$//' \
	      -e '/^$$/ d' -e 's/$$/ :/' < $(@:%.o=%.d) >> $(@:%.o=%.P); \
	  rm -f $(@:%.o=%.d)

test_nu: $(TESTOBJS) $(filter-out obj/init.o,$(OBJS))
	$(CXX) $(CFLAGS) -o $@ $(LIBPATHS) $^ $(LIBS) $(TESTLIBS)

clean:
	-rm -f nud test_nu
	-rm -f obj/*.o obj/*.P obj/build.h
	-rm -f obj-test/*.o obj-test/*.P

FORCE:
