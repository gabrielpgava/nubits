# Windows CLI daemon build for the 64-bit MSYS2/MinGW toolchain.

USE_UPNP ?= 0
BOOST_LIB_SUFFIX ?= -mt
BOOST_THREAD_LIB_SUFFIX ?= $(BOOST_LIB_SUFFIX)
BDB_LIB_SUFFIX ?=

DEFS = -DWIN32 -D_WINDOWS -DBOOST_THREAD_USE_LIB -DBOOST_SPIRIT_THREADSAFE \
	-DBOOST_BIND_GLOBAL_PLACEHOLDERS -D_WIN32_WINNT=0x0601
INCLUDEPATHS = -I. -Iobj
LIBPATHS =

LIBS = \
	-lboost_filesystem$(BOOST_LIB_SUFFIX) \
	-lboost_program_options$(BOOST_LIB_SUFFIX) \
	-lboost_thread$(BOOST_THREAD_LIB_SUFFIX) \
	-lboost_chrono$(BOOST_LIB_SUFFIX) \
	-ldb_cxx$(BDB_LIB_SUFFIX) \
	-lcurl -lssl -lcrypto \
	-lws2_32 -lshlwapi -lole32 -loleaut32 -luuid -lgdi32 \
	-liphlpapi -lkernel32 -luser32 -ladvapi32 -lshell32

ifneq ($(USE_UPNP),0)
ifneq ($(USE_UPNP),-)
	DEFS += -DUSE_UPNP=$(USE_UPNP) -DSTATICLIB
	LIBS += -lminiupnpc
endif
endif

CXX ?= g++
CXXFLAGS ?= -std=c++17 -mthreads -O2 -Wall -Wextra -Wformat -Wformat-security \
	-Wno-sign-compare -Wno-invalid-offset -Wno-unused-parameter \
	-Wno-deprecated-declarations $(DEFS) $(INCLUDEPATHS)

OBJS = \
	obj/scanbalance.o \
	obj/version.o \
	obj/checkpoints.o \
	obj/netbase.o \
	obj/addrman.o \
	obj/crypter.o \
	obj/key.o \
	obj/db.o \
	obj/init.o \
	obj/irc.o \
	obj/keystore.o \
	obj/main.o \
	obj/net.o \
	obj/protocol.o \
	obj/bitcoinrpc.o \
	obj/rpcdump.o \
	obj/script.o \
	obj/util.o \
	obj/wallet.o \
	obj/walletdb.o \
	obj/noui.o \
	obj/kernel.o \
	obj/distribution.o \
	obj/vote.o \
	obj/liquidityinfo.o \
	obj/datafeed.o \
	obj/autoupdate.o

all: nud.exe

obj/%.o: %.cpp
	@mkdir -p obj
	$(CXX) -c $(CXXFLAGS) -o $@ $<

nud.exe: $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $(LIBPATHS) $^ $(LDFLAGS) $(LIBS)

TESTDEFS = -DTEST_DATA_DIR=\"$(CURDIR)/test/data\"
TESTOBJS := $(patsubst test/%.cpp,obj-test/%.o,$(wildcard test/*.cpp))

obj-test/%.o: test/%.cpp
	@mkdir -p obj-test
	$(CXX) -c $(TESTDEFS) $(CXXFLAGS) -o $@ $<

test_nu.exe: $(TESTOBJS) $(filter-out obj/init.o,$(OBJS))
	$(CXX) $(CXXFLAGS) -o $@ $^ -lboost_unit_test_framework $(LDFLAGS) $(LIBS)

clean:
	-rm -f nud.exe test_nu.exe
	-rm -f obj/*.o obj-test/*.o
